rules_version = '2';
// =========================================================
// TURBINE BRASIL — Regras de segurança do Firestore (v2 — endurecida)
// -----------------------------------------------------------
// Substitui o arquivo enviado anteriormente. Cole em:
// Console do Firebase > Firestore Database > Regras > Publicar.
//
// O que mudou em relação à v1 que você enviou:
//  1) create de orders/deposits agora valida tipo e faixa de
//     amount/quantity/link (mitiga preço manipulado pelo cliente
//     enquanto a Cloud Function createOrder/createDeposit não é
//     usada — ver funcao/index.js).
//  2) update de users/orders/deposits agora usa hasOnly() para
//     limitar exatamente quais campos o dono pode alterar (fecha
//     mass-assignment residual).
//  3) Comentário deixando claro que, quando as Cloud Functions
//     createOrder/createDeposit (functions/index.js) forem
//     publicadas, o ideal é o CLIENTE PARAR de escrever
//     diretamente em orders/deposits (usar allow create: if false
//     e deixar só a Cloud Function, que roda com Admin SDK e
//     ignora regras, criar os documentos). Isso é opcional: com
//     os limites abaixo, escrita direta do cliente já fica
//     bem mais segura mesmo sem essa migração.
// =========================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // Lista de e-mails Google com acesso de administrador — precisa ficar
    // IDÊNTICA à lista adminEmails em APP_CONFIG (index.html) e à lista
    // ADMIN_EMAILS em functions/index.js. Pra adicionar/remover alguém,
    // edite os três lugares e publique de novo.
    // Recomendação de médio prazo: migrar para custom claim
    // (request.auth.token.admin == true) — ver scripts/setAdminClaim.js.
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && (
          request.auth.token.email == "piiterthor@gmail.com"
          || request.auth.token.email == "marketing.turbinebrasil@gmail.com"
        );
    }

    // ---- users/{uid} ----
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.balance == 0
        && request.resource.data.keys().hasOnly(
             ['uid', 'name', 'email', 'photoURL', 'balance', 'createdAt', 'updatedAt']);

      allow update: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.balance == resource.data.balance
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'email', 'photoURL', 'updatedAt'])
        );

      allow delete: if false;
    }

    // ---- orders/{orderId} ----
    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending_payment"
        // ---- validação de tipo/faixa (mitigação enquanto a Cloud Function
        // createOrder não é a via obrigatória — ver comentário no topo) ----
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 500
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0
        && request.resource.data.quantity <= 100000
        && request.resource.data.link is string
        && request.resource.data.link.size() > 0
        && request.resource.data.link.size() < 500
        && request.resource.data['service'] is string
        && request.resource.data.platform is string;

      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.userId == request.auth.uid
          // Aceita tanto "ainda não informou o pagamento" quanto "já
          // informou" como estado ATUAL válido — isso torna a gravação
          // idempotente: se o cliente clicar "Já fiz o pagamento" duas
          // vezes (duplo clique/toque, retry automático de rede, etc.),
          // a 2ª tentativa também é aceita (é a mesma informação de
          // novo) em vez de ser recusada por já não estar mais
          // "pending_payment" — isso é o que causava o alerta de "Sem
          // permissão para gravar" mesmo com o pagamento já salvo com
          // sucesso da 1ª vez (achado do dia 22/08/2026).
          && resource.data.status in ["pending_payment", "payment_reported"]
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.amount == resource.data.amount
          && request.resource.data.quantity == resource.data.quantity
          && request.resource.data['service'] == resource.data['service']
          && request.resource.data.platform == resource.data.platform
          && request.resource.data.status in ["pending_payment", "payment_reported"]
          // só pode tocar nestes campos nesta atualização feita pelo cliente:
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'pixPayload', 'pixKey', 'paymentReportedAt', 'updatedAt'])
        );

      allow delete: if false;
    }

    // ---- deposits/{depositId} ----
    match /deposits/{depositId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending_payment"
        && request.resource.data.amount is number
        && request.resource.data.amount >= 1
        && request.resource.data.amount <= 5000;

      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.userId == request.auth.uid
          // Mesma mudança explicada no bloco de orders/{orderId} acima:
          // idempotente contra clique duplo/retry (achado 22/08/2026).
          && resource.data.status in ["pending_payment", "payment_reported"]
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.amount == resource.data.amount
          && request.resource.data.status in ["pending_payment", "payment_reported"]
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'pixPayload', 'pixKey', 'paymentReportedAt', 'updatedAt'])
        );

      allow delete: if false;
    }

    // ---- audit_logs/{logId} — opcional, ver functions/index.js ----
    // Só a Cloud Function (Admin SDK, que ignora estas regras) escreve aqui.
    // Do lado do cliente, só o admin pode LER a trilha de auditoria.
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Nega tudo que não foi previsto acima.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
